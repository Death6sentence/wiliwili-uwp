+void WinRTInputManager::drawCursor(NVGcontext* vg)
+{
+    if (!hasMousePosition || pointerLocked)
+        return;
+
+    nvgBeginPath(vg);
+    nvgMoveTo(vg, cursorPosition.x, cursorPosition.y);
+    nvgLineTo(vg, cursorPosition.x + 5, cursorPosition.y + 18);
+    nvgLineTo(vg, cursorPosition.x + 8, cursorPosition.y + 11);
+    nvgLineTo(vg, cursorPosition.x + 15, cursorPosition.y + 10);
+    nvgClosePath(vg);
+    nvgFillColor(vg, nvgRGB(255, 255, 255));
+    nvgFill(vg);
+    nvgStrokeWidth(vg, 1.5f);
+    nvgStrokeColor(vg, nvgRGB(0, 0, 0));
+    nvgStroke(vg);
+}
