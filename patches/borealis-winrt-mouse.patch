+void WinRTInputManager::updateMousePosition(winrt::Windows::Foundation::Point const& position)
+{
+    pointerOffsetBuffer.x += hasMousePosition ? position.X - mousePosition.x : 1.0f;
+    pointerOffsetBuffer.y += hasMousePosition ? position.Y - mousePosition.y : 0.0f;
+    mousePosition.x = position.X;
+    mousePosition.y = position.Y;
+    if (!hasMousePosition)
+        coreWindow.PointerCursor(nullptr);
+    hasMousePosition = true;
 }
 
